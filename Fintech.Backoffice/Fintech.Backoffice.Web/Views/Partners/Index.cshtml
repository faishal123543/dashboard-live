@model List<Fintech.Backoffice.Web.Controllers.PartnerViewModel>
@{
    ViewData["Title"] = "Partner Management";
    var totalApps = Model.Sum(p => p.TotalApps);
    var totalApproved = Model.Sum(p => p.TotalApproved);
    var avgApprovalRate = Model.Any() ? Model.Average(p => p.ApprovalRate) : 0;
}

<!-- Summary Cards -->
<div class="kpi-grid mb-4">
    <div class="kpi-card info">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-handshake"></i></div>
                Total Partners
            </div>
        </div>
        <div class="kpi-card-value">@Model.Count</div>
    </div>
    <div class="kpi-card success">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-file-invoice"></i></div>
                Total Applications
            </div>
        </div>
        <div class="kpi-card-value">@totalApps.ToString("N0")</div>
    </div>
    <div class="kpi-card success">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-dollar-sign"></i></div>
                Total Approved
            </div>
        </div>
        <div class="kpi-card-value">$@(totalApproved.ToString("N0"))</div>
    </div>
    <div class="kpi-card warning">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-percent"></i></div>
                Avg Approval Rate
            </div>
        </div>
        <div class="kpi-card-value">@avgApprovalRate.ToString("F1")%</div>
    </div>
</div>

<!-- Partners Cards Grid -->
<div class="kpi-grid mb-4" style="grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));">
    @foreach (var p in Model)
    {
        <div class="chart-card" style="padding: 20px;">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h6 style="margin:0; color: var(--text-primary); font-weight: 600;">@p.PartnerName</h6>
                    <small class="text-muted">Code: @p.PartnerCode</small>
                </div>
                <span class="status-badge completed">
                    <i class="fas fa-percentage"></i> @p.ApprovalRate.ToString("F1")%
                </span>
            </div>

            <!-- Stats Row -->
            <div class="d-flex justify-content-between mb-3" style="border-top:1px solid var(--border); padding-top:12px;">
                <div class="text-center">
                    <div style="font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px;">TOTAL</div>
                    <div style="font-weight: 700; color: var(--text-primary); font-size: 18px;">@p.TotalApps</div>
                </div>
                <div class="text-center">
                    <div style="font-size: 11px; color: var(--success); letter-spacing: 0.5px;">COMPLETED</div>
                    <div style="font-weight: 700; color: var(--success); font-size: 18px;">@p.Completed</div>
                </div>
                <div class="text-center">
                    <div style="font-size: 11px; color: var(--accent); letter-spacing: 0.5px;">IN-PROG</div>
                    <div style="font-weight: 700; color: var(--accent); font-size: 18px;">@p.InProgress</div>
                </div>
                <div class="text-center">
                    <div style="font-size: 11px; color: var(--danger); letter-spacing: 0.5px;">REJECTED</div>
                    <div style="font-weight: 700; color: var(--danger); font-size: 18px;">@p.Rejected</div>
                </div>
            </div>

            <!-- Approval Rate Bar -->
            <div style="margin-bottom: 10px;">
                <div class="d-flex justify-content-between mb-1">
                    <small style="color: var(--text-muted);">Approval Rate</small>
                    <small style="color: var(--text-primary); font-weight: 600;">@p.ApprovalRate.ToString("F1")%</small>
                </div>
                <div style="height: 6px; background: var(--bg-hover); border-radius: 3px; overflow: hidden;">
                    <div style="width: @p.ApprovalRate.ToString("F0")%; height: 100%; background: linear-gradient(90deg, #00d4ff, #00ff88);"></div>
                </div>
            </div>

            <!-- Total Approved -->
            <div class="d-flex justify-content-between align-items-center mt-3" style="border-top:1px solid var(--border); padding-top:12px;">
                <small class="text-muted"><i class="fas fa-envelope me-1"></i> @p.ContactEmail</small>
                <strong style="color: var(--success);">$@(p.TotalApproved.ToString("N0"))</strong>
            </div>
        </div>
    }
</div>

<!-- Comparison Table -->
<div class="table-section">
    <div class="table-section-header">
        <h5 class="section-title"><i class="fas fa-table me-2" style="color: var(--accent);"></i> Partners Comparison Table</h5>
        <small class="text-muted">@Model.Count partners</small>
    </div>
    <div class="table-responsive">
        <table id="partnersTable" class="table">
            <thead>
                <tr>
                    <th>PARTNER</th>
                    <th>CODE</th>
                    <th>TOTAL</th>
                    <th>COMPLETED</th>
                    <th>REJECTED</th>
                    <th>IN-PROGRESS</th>
                    <th>APPROVAL RATE</th>
                    <th>TOTAL APPROVED</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.PartnerName</strong></td>
                        <td><code style="color: var(--accent); background: var(--bg-hover); padding: 2px 6px; border-radius: 4px;">@p.PartnerCode</code></td>
                        <td>@p.TotalApps</td>
                        <td><span class="status-badge completed">@p.Completed</span></td>
                        <td><span class="status-badge rejected">@p.Rejected</span></td>
                        <td><span class="status-badge in-progress">@p.InProgress</span></td>
                        <td><strong>@p.ApprovalRate.ToString("F1")%</strong></td>
                        <td><strong style="color: var(--success);">$@(p.TotalApproved.ToString("N0"))</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#partnersTable').DataTable({
                pageLength: 10,
                order: [[7, 'desc']]
            });
        });
    </script>
}
