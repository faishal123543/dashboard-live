@{
    ViewData["Title"] = "Analytics Reports";
}

<!-- Summary Stats -->
<div class="kpi-grid mb-4">
    <div class="kpi-card info">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-chart-line"></i></div>
                YoY Growth
            </div>
        </div>
        <div class="kpi-card-value">+24.5%</div>
        <span class="kpi-card-change"><i class="fas fa-arrow-up"></i> vs last year</span>
    </div>
    <div class="kpi-card success">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-money-bill-wave"></i></div>
                Total Disbursed
            </div>
        </div>
        <div class="kpi-card-value">$18.45M</div>
        <span class="kpi-card-change"><i class="fas fa-arrow-up"></i> 12.3%</span>
    </div>
    <div class="kpi-card warning">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-clock"></i></div>
                Avg Processing
            </div>
        </div>
        <div class="kpi-card-value">3.2 days</div>
        <span class="kpi-card-change negative"><i class="fas fa-arrow-down"></i> 0.5 days</span>
    </div>
    <div class="kpi-card danger">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-percent"></i></div>
                Approval Rate
            </div>
        </div>
        <div class="kpi-card-value">83.6%</div>
        <span class="kpi-card-change"><i class="fas fa-arrow-up"></i> 2.1%</span>
    </div>
</div>

<!-- Chart Row 1 -->
<div class="charts-grid">
    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title"><i class="fas fa-chart-bar" style="color: var(--accent);"></i> Monthly Approved Amounts</div>
                <div class="chart-card-amount">$18.45M <span class="change">+12.3%</span></div>
            </div>
            <div class="chart-filters"><button class="filter-btn active">Last 6 months</button></div>
        </div>
        <div class="chart-canvas-wrapper">
            <canvas id="monthlyAmountsChart"></canvas>
        </div>
    </div>
    <div class="chart-card">
        <div class="chart-card-header">
            <div>
                <div class="chart-card-title"><i class="fas fa-chart-pie" style="color: var(--accent);"></i> Status Breakdown</div>
                <div class="chart-card-amount">1,247 <span class="change">Total</span></div>
            </div>
        </div>
        <div class="chart-canvas-wrapper">
            <canvas id="statusBreakdownChart"></canvas>
        </div>
    </div>
</div>

<!-- Chart Row 2 -->
<div class="charts-grid" style="grid-template-columns: 1fr 1fr;">
    <div class="chart-card">
        <div class="chart-card-header">
            <div class="chart-card-title"><i class="fas fa-handshake" style="color: var(--accent);"></i> Top Performing Partners</div>
        </div>
        <div class="chart-canvas-wrapper">
            <canvas id="topPartnersChart"></canvas>
        </div>
    </div>
    <div class="chart-card">
        <div class="chart-card-header">
            <div class="chart-card-title"><i class="fas fa-chart-area" style="color: var(--accent);"></i> Submitted vs Approved Trend</div>
        </div>
        <div class="chart-canvas-wrapper">
            <canvas id="growthTrendChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            fetch('/Reports/GetReportData')
                .then(r => r.json())
                .then(data => renderReportCharts(data));
        });

        function renderReportCharts(d) {
            // Monthly Approved Amounts - Bar Chart
            new Chart(document.getElementById('monthlyAmountsChart'), {
                type: 'bar',
                data: {
                    labels: d.monthlyAmounts.labels,
                    datasets: [{
                        label: 'Approved Amount',
                        data: d.monthlyAmounts.values,
                        backgroundColor: 'rgba(0, 212, 255, 0.7)',
                        borderColor: '#00d4ff',
                        borderWidth: 2,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { ticks: { callback: v => '$' + (v/1000000).toFixed(1) + 'M' } }
                    }
                }
            });

            // Status Breakdown - Doughnut
            new Chart(document.getElementById('statusBreakdownChart'), {
                type: 'doughnut',
                data: {
                    labels: d.statusBreakdown.labels,
                    datasets: [{
                        data: d.statusBreakdown.values,
                        backgroundColor: d.statusBreakdown.colors,
                        borderColor: '#1e2533',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // Top Partners - Horizontal Bar
            new Chart(document.getElementById('topPartnersChart'), {
                type: 'bar',
                data: {
                    labels: d.topPartners.labels,
                    datasets: [{
                        label: 'Applications',
                        data: d.topPartners.values,
                        backgroundColor: '#7c3aed',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } }
                }
            });

            // Growth Trend - Line
            new Chart(document.getElementById('growthTrendChart'), {
                type: 'line',
                data: {
                    labels: d.growthTrend.labels,
                    datasets: [
                        { label: 'Submitted', data: d.growthTrend.submitted, borderColor: '#00d4ff', backgroundColor: 'rgba(0,212,255,0.1)', fill: true, tension: 0.4 },
                        { label: 'Approved', data: d.growthTrend.approved, borderColor: '#00ff88', backgroundColor: 'rgba(0,255,136,0.1)', fill: true, tension: 0.4 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }
    </script>
}
