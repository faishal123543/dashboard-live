                    <td><span class="status-badge in-progress"><i class="fas fa-clock"></i> In Progress</span></td>
                    <td>Today</td>
                </tr>
                <tr>
                    <td><strong>APP-2024-001009</strong></td>
                    <td>Rashid Al-Suwaidi</td>
                    <td>+971 509 012 345</td>
                    <td>Secure Lending</td>
                    <td><strong>$70,000</strong></td>
                    <td><span class="status-badge completed"><i class="fas fa-check"></i> Completed</span></td>
                    <td>Yesterday</td>
                </tr>
                <tr>
                    <td><strong>APP-2024-002005</strong></td>
                    <td>Sara Al-Falahi</td>
                    <td>+971 510 123 456</td>
                    <td>Digital Loans</td>
                    <td>-</td>
                    <td><span class="status-badge rejected"><i class="fas fa-times"></i> Rejected</span></td>
                    <td>2 days ago</td>
                </tr>
                <tr>
                    <td><strong>APP-2024-001008</strong></td>
                    <td>Hana Al-Khayeli</td>
                    <td>+971 508 901 234</td>
                    <td>Premium Financial</td>
                    <td><strong>$80,000</strong></td>
                    <td><span class="status-badge completed"><i class="fas fa-check"></i> Completed</span></td>
                    <td>3 days ago</td>
                </tr>
                <tr>
                    <td><strong>APP-2024-004003</strong></td>
                    <td>Salim Al-Kaabi</td>
                    <td>+971 507 890 123</td>
                    <td>Global Finance Hub</td>
                    <td>-</td>
                    <td><span class="status-badge cancelled"><i class="fas fa-ban"></i> Cancelled</span></td>
                    <td>5 days ago</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initializeAllCharts();
            startAutoRefresh();
            updateLastUpdatedTime();
        });
    </script>
}
