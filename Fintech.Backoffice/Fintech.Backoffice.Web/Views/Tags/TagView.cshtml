@model List<Fintech.Backoffice.Web.Controllers.ApplicationViewModel>
@{
    var tagName = ViewData["TagName"]?.ToString() ?? "Tagged";
    var tagDesc = ViewData["TagDescription"]?.ToString() ?? "";
    var tagColor = ViewData["TagColor"]?.ToString() ?? "info";
    var tagIcon = ViewData["TagIcon"]?.ToString() ?? "fa-tag";
    ViewData["Title"] = tagName + " Applications";

    var completedApps = Model.Where(x => x.Status == "Completed").ToList();
    var totalApproved = completedApps.Sum(x => x.ApprovedAmount);
}

<!-- Banner -->
<div class="chart-card mb-4" style="background: linear-gradient(135deg, var(--bg-card), var(--bg-secondary)); border-left: 4px solid var(--@tagColor);">
    <div class="d-flex align-items-center gap-3">
        <div class="kpi-card-icon" style="width: 50px; height: 50px; font-size: 22px; background: rgba(0,212,255,0.15); color: var(--@tagColor);">
            <i class="fas @tagIcon"></i>
        </div>
        <div>
            <h4 style="margin:0; color: var(--text-primary);">@tagName Tag</h4>
            <small class="text-muted">@tagDesc</small>
        </div>
    </div>
</div>

<!-- Summary KPIs -->
<div class="kpi-grid mb-4">
    <div class="kpi-card @tagColor">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-file-invoice"></i></div>
                Tagged Count
            </div>
        </div>
        <div class="kpi-card-value">@Model.Count</div>
    </div>
    <div class="kpi-card success">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-check-circle"></i></div>
                Completed
            </div>
        </div>
        <div class="kpi-card-value">@Model.Count(x => x.Status == "Completed")</div>
    </div>
    <div class="kpi-card danger">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-times-circle"></i></div>
                Rejected
            </div>
        </div>
        <div class="kpi-card-value">@Model.Count(x => x.Status == "Rejected")</div>
    </div>
    <div class="kpi-card info">
        <div class="kpi-card-header">
            <div class="kpi-card-title">
                <div class="kpi-card-icon"><i class="fas fa-dollar-sign"></i></div>
                Total Approved
            </div>
        </div>
        <div class="kpi-card-value">$@totalApproved.ToString("N0")</div>
    </div>
</div>

<!-- Applications Table -->
<div class="table-section">
    <div class="table-section-header">
        <h5 class="section-title"><i class="fas @tagIcon me-2" style="color: var(--@tagColor);"></i> @tagName Applications List</h5>
        <small class="text-muted">@Model.Count applications</small>
    </div>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table id="tagTable" class="table">
                <thead>
                    <tr>
                        <th>PROCESS NUMBER</th>
                        <th>CUSTOMER</th>
                        <th>MOBILE</th>
                        <th>PARTNER</th>
                        <th>AMOUNT</th>
                        <th>STATUS</th>
                        <th>DAYS OPEN</th>
                        <th>DATE</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        var daysOpen = (int)(DateTime.Now - app.ApplicationDate).TotalDays;
                        <tr>
                            <td><strong>@app.ProcessNumber</strong></td>
                            <td>@app.CustomerName</td>
                            <td>@app.MobileNumber</td>
                            <td>@app.PartnerName</td>
                            <td><strong>@(app.ApprovedAmount > 0 ? "$" + app.ApprovedAmount.ToString("N0") : "-")</strong></td>
                            <td>
                                @{
                                    var statusClass = app.Status.ToLower().Replace(" ", "-");
                                    var icon = app.Status switch
                                    {
                                        "Completed" => "fa-check",
                                        "Rejected" => "fa-times",
                                        "In-Progress" => "fa-clock",
                                        "Cancelled" => "fa-ban",
                                        _ => "fa-question"
                                    };
                                }
                                <span class="status-badge @statusClass"><i class="fas @icon"></i> @app.Status</span>
                            </td>
                            <td>
                                @if (daysOpen >= 5)
                                {
                                    <span class="status-badge rejected">@daysOpen days</span>
                                }
                                else if (daysOpen >= 2)
                                {
                                    <span class="status-badge cancelled">@daysOpen days</span>
                                }
                                else
                                {
                                    <span class="status-badge completed">@daysOpen days</span>
                                }
                            </td>
                            <td>@app.ApplicationDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas @tagIcon" style="font-size: 64px; color: var(--text-muted); opacity: 0.3;"></i>
            <p class="text-muted mt-3">No @tagName.ToLower() applications found</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#tagTable').length) {
                $('#tagTable').DataTable({
                    pageLength: 10,
                    order: [[7, 'desc']]
                });
            }
        });
    </script>
}
