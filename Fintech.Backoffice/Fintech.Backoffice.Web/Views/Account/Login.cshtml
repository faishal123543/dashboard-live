@model Fintech.Backoffice.Web.Controllers.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <div class="auth-logo">
        <i class="fas fa-chart-line"></i>
    </div>
    <h2 class="auth-title">Welcome Back</h2>
    <p class="auth-subtitle">Enter your email and we'll send you a one-time password to sign in.</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div class="auth-alert auth-alert-danger">
            <i class="fas fa-exclamation-circle"></i>
            @ViewData.ModelState[""]!.Errors.First().ErrorMessage
        </div>
    }

    <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        @Html.AntiForgeryToken()

        <div class="auth-input-group">
            <label asp-for="Email" class="auth-label">Email Address</label>
            <div class="auth-input-wrapper">
                <i class="fas fa-envelope auth-input-icon"></i>
                <input asp-for="Email" type="email" class="auth-input" placeholder="you@example.com" autocomplete="email" autofocus />
            </div>
            <span asp-validation-for="Email" class="auth-error"></span>
        </div>

        <button type="submit" class="auth-btn">
            <i class="fas fa-paper-plane"></i> Send OTP
        </button>
    </form>

    <div class="auth-footer">
        <i class="fas fa-shield-alt"></i> Secure passwordless login via email OTP
    </div>
</div>
