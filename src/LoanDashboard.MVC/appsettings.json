{
  "ConnectionStrings": {
    "LoanPortal": "Server=localhost\\SQLEXPRESS01;Database=loan_dashboard;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;Connection Timeout=10"
  },

  "Poller": {
    "IntervalSeconds": 10
  },

  "KnownStages": [
    "Financial Data",
    "Salary Certificate Check",
    "Offer Selection",
    "Addition of Asset",
    "Payment Collection",
    "Card Verification",
    "Call Confirmation",
    "E-Contract Signing",
    "E-Promissory Note Acceptance",
    "Delivery Status",
    "Delivery Acknowledgement",
    "Commodity Purchase"
  ],

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*",
  "Urls": "http://localhost:5100"
}
